{
  "name": "Joan 6/13 AppDaemon Dashboard Generator",
  "version": "2.0.1",
  "slug": "joan_generator",
  "description": ".dash file creator for AppDaemon, optimized for Visionect Joan 6/13 screens.",
  "url": "https://github.com/Adam7411/joan_generator",
  "arch": [
    "aarch64",
    "amd64",
    "armhf"
  ],
  "startup": "application",
  "boot": "auto",
  "hassio_api": true,
  "hassio_role": "manager",
  "init": false,
  "panel_icon": "mdi:tablet-dashboard",
  "panel_title": "Joan 6/13 Generator",
  "ingress": true,
  "ingress_port": 5000,
  "homeassistant_api": true,
  "ports": {
    "5000/tcp": 5000
  },
  "webui": "[PROTO:ssl]://[HOST]:[PORT:5000]/",
  "options": {
    "manual_token": ""
  },
  "schema": {
    "manual_token": "str"
  }
}
