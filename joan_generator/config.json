{
  "name": "Joan 6: AppDaemon Dashboard Generator",
  "version": "1.2.1",
  "slug": "joan_generator",
  "description": "Dashboard generator Joan 6.",
  "map": ["config", "share", "addon_configs"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "panel_icon": "mdi:tablet-dashboard",
  "homeassistant_api": true,
  "ports": {
    "5000/tcp": 5000
  },
  "webui": "http://[HOST]:[PORT:5000]/",
  "options": {
    "manual_token": "",
    "appdaemon_path": ""
  },
  "schema": {
    "manual_token": "str",
    "appdaemon_path": "str"
  }
}
